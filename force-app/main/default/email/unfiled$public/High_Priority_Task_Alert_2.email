<messaging:emailTemplate subject="High Priority Task Alert – {!relatedTo.Task_Name__c}"  
    recipientType="User"
    relatedToType="Project_Task__c">

    <messaging:htmlEmailBody >
Hello {!recipient.Name},<br/><br/>

A High Priority task has been created.<br/><br/>

<b>Task Details:</b><br/>
- Task Name: {!relatedTo.Task_Name__c}<br/>
- Related Project: {!relatedTo.Related_Project__r.Name}<br/>
- Due Date: {!relatedTo.Due_Date__c}<br/>
- Priority: {!relatedTo.Priority__c}<br/>
- Task Owner: {!relatedTo.Task_Owner__r.Name}<br/><br/>

<b>View Task:</b> 
<a href="{!LEFT($Api.Partner_Server_URL_540, FIND('/services', $Api.Partner_Server_URL_540)-1)}/lightning/r/Project_Task__c/{!relatedTo.Id}/view">
    Click here to view the Task
</a>


    </messaging:htmlEmailBody>

</messaging:emailTemplate>